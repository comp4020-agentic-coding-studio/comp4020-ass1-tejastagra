const startups = STARTUP_INFO.slice(0, STARTUP_COUNT).map((info, i) => ({
  id: i + 1,
  name: info.name,
  description: info.description,
  icon: info.icon,
  bg: info.bg,
  accent: info.accent,
  initial: 0,
