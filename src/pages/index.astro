// Illustrative diagrams for the explainer section below: static example
// figures that show the shape of the power law, not live simulation output.
const OUTCOME_BUCKETS = [
  { label: "0 to 1x", value: 65 },
  { label: "1 to 5x", value: 25 },
  { label: "5 to 10x", value: 7 },
  { label: "10x or more", value: 3 },
];

const CONTRIBUTION_EXAMPLE = [70, 7, 5, 4, 3, 2, 2, 1.5, 1.5, 1, 1, 0.8, 0.7, 0.3, 0.2];

const STRATEGY_EXAMPLE = [
  { label: "One concentrated bet", value: 1.3 },
  { label: "Even split", value: 1.2 },
  { label: "A typical mixed split", value: 1.1 },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>COMP4020 prototype</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href={import.meta.env.BASE_URL}>Home</a>
      </nav>
    </header>
    <main>
      <p class="eyebrow">A venture fund investment simulator</p>
      <h1>The power law allocator</h1>
      <p class="intro">
        A "venture fund" is a pool of money that professional investors put into young,
        unproven companies ("startups") in exchange for a stake in each one. Most startups fail
        or barely survive. A venture fund makes money anyway, because occasionally one of its
        startups becomes huge, and that single success pays for all the failures many times
        over. This page walks through how that actually plays out. You play fund manager: split
        a fixed pool of money across {STARTUP_COUNT} startups, then see what comes back.
      </p>
      <p class="skip-link">
        New to venture investing? <a href="#explainer">Read how the power law works first ↓</a>
      </p>
      <p class="framing">
        This fund raised ${RAISED_TOTAL.toLocaleString("en-AU")}. Fees take about 20% over its
        life. That leaves <strong data-testid="fund-total">${FUND_TOTAL.toLocaleString("en-AU")}</strong> to
        invest in {STARTUP_COUNT} startups. However you split it, one outlier (a single
        startup that returns far more than the rest) decides almost all of your return.
        <button type="button" class="info-toggle" id="fee-info-toggle" aria-expanded="false" aria-controls="fee-info">
          Why only 80%?
        </button>
      </p>
      <div id="fee-info" class="fee-info" hidden>
        <p>
          Funds typically charge a management fee of around 2% a year, charged across roughly ten
          years, to cover salaries and other running costs. That works out to about 20% of the
          ${RAISED_TOTAL.toLocaleString("en-AU")} raised, leaving roughly ${FUND_TOTAL.toLocaleString("en-AU")} to
          actually invest in startups. This is a modelled assumption, not a specific fund's real
          fee schedule.
        </p>
      </div>

      <div class="remaining-bar">
        <p data-testid="fund-remaining" aria-live="polite" class="remaining-number">
          Remaining: ${FUND_TOTAL.toLocaleString("en-AU")}
        </p>
        <p class="allocation-prompt" aria-live="polite">
          Invest the full ${FUND_TOTAL.toLocaleString("en-AU")} to continue.
        </p>
      </div>

      <form id="allocator-form">
        <div class="grid-controls">
          <button type="button" id="reset-button" class="randomise-button">Reset</button>
          <button type="button" id="randomise-button" class="randomise-button">
            Randomise: invest all ${FUND_TOTAL.toLocaleString("en-AU")}
          </button>
        </div>
        <ul class="startup-grid">
          {
            startups.map((startup) => (
              <li class="startup-card" style={`background:${startup.bg}; --card-accent:${startup.accent};`}>
                <div class="startup-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24">${startup.icon}</svg>`} />
                <p class="startup-name">{startup.name}</p>
                <p class="startup-description">{startup.description}</p>
                <p class="card-return" id={`return-${startup.id}`} aria-live="polite"></p>
                <div class="stepper">
                  <button
                    type="button"
                    class="step-btn"
                    data-action="decrement"
                    data-index={startup.id - 1}
                    aria-label={`Decrease allocation for ${startup.name}`}
                  >
                    &minus;
                  </button>
                  <output for={`slider-${startup.id}`} id={`value-${startup.id}`}>
                    ${startup.initial.toLocaleString("en-AU")}
                  </output>
                  <button
                    type="button"
                    class="step-btn"
                    data-action="increment"
                    data-index={startup.id - 1}
                    aria-label={`Increase allocation for ${startup.name}`}
                  >
                    &plus;
                  </button>
                </div>
                <input
                  type="range"
                  id={`slider-${startup.id}`}
                  name={`slider-${startup.id}`}
                  data-testid="allocation-slider"
                  data-index={startup.id - 1}
                  class="visually-hidden"
                  tabindex="-1"
                  aria-hidden="true"
                  min="0"
                  max={FUND_TOTAL}
                  step="10000"
                  value={startup.initial}
                />
              </li>
            ))
          }
        </ul>

        <button type="submit" data-testid="allocate-submit" class="allocate-button">Invest</button>
      </form>

      <section class="payoff">
        <p data-testid="fund-return" class="payoff-number" aria-live="polite"></p>
        <p class="payoff-compare"></p>
      </section>

      <section class="breakdown">
        <h2>Startup returns, ranked</h2>
        <p class="breakdown-caption">
          The same draw shown above, per startup. Whichever one lands at the top is what decided
          your fund's return, not how you split the money.
        </p>
        <ol class="breakdown-list" id="breakdown-list"></ol>
      </section>

      <section class="explainer" id="explainer">
        <h2>How the power law works</h2>
        <p class="explainer-intro">
          A "return multiple" is what a fund gets back for every dollar it invests: a 2x means
          the money doubled, a 0.3x means most of it was lost. A "power law" here just means
          that a few results are enormously bigger than all the rest put together, rather than
          outcomes clustering around an average. Venture funds live and die by that one fact.
        </p>
        <p class="explainer-intro">
          When you click "Invest" in the allocator above, the site does "the draw": it randomly
          picks a return multiple for each startup from a distribution shaped like the one below,
          then adds up what your money invested in each one turned into. That is what produces
          the fund return you see, and it is why the same allocation can turn out very
          differently each time you invest.
        </p>

        <div class="explainer-step">
          <div class="explainer-text">
            <h3>Most bets return less than they cost</h3>
            <p>
              Across a large number of venture deals, most return less than the money put in.
              A modest share do well. Only a small slice return ten times or more. Statisticians
              call this shape "fat-tailed": a lot of small losses, and a few enormous wins far
              out in the "tail" of the distribution. It is the reason a single startup can end
              up mattering more than the other fourteen in this fund combined.
            </p>
            <p>
              "Tail heaviness" describes how extreme those rare wins are. A low tail means the
              biggest winners are only modestly larger than everything else. A high tail means
              almost every startup fails or breaks even, but the rare one that works pays back
              dozens of times its cost, which is closer to how real venture returns behave. Drag
              the slider to move from a low tail to a high tail and watch the bars reshape: the
              loss and modest-return bars shrink while the rare, huge-return bar grows. This is
              an illustrative model, not a measurement of real deals.
            </p>
          </div>
          <div class="explainer-diagram">
            <div class="bar-chart" id="tail-bar-chart">
              {
                OUTCOME_BUCKETS.map((bucket, i) => (
                  <div class="bar-chart-item">
                    <div class="bar-chart-track">
                      <div class="bar-chart-fill" data-bucket={i} style={`height:${bucket.value}%;`} />
                    </div>
                    <p class="bar-chart-label">{bucket.label}</p>
                    <p class="bar-chart-value" data-bucket-value={i}>{bucket.value}%</p>
                  </div>
                ))
              }
            </div>
            <label class="tail-slider-label" for="tail-slider">
              Tail heaviness: <span id="tail-slider-value">mild</span>
            </label>
            <input type="range" id="tail-slider" min="0" max="100" value="0" step="1" />
            <div class="tail-slider-scale">
              <span>Mild</span>
              <span>Extreme</span>
            </div>
          </div>
        </div>

        <div class="explainer-step">
          <div class="explainer-text">
            <h3>One outlier carries the fund</h3>
            <p>
              Rank a fund's startups by how much each one contributes to the total money
              returned. In a typical outcome, one of them accounts for most of it and the rest
              barely register, a single "outlier" carrying the whole fund.
            </p>
            <p id="contribution-caption">
              This example ranks {STARTUP_COUNT} illustrative startups by contribution: the
              tallest bar alone is worth more than all the others combined. Invest your own fund
              above and this chart will switch to showing your actual result instead.
            </p>
          </div>
          <div class="explainer-diagram">
            <div class="bar-chart bar-chart-tight" id="contribution-chart">
              {
                CONTRIBUTION_EXAMPLE.map((value) => (
                  <div class="bar-chart-item">
                    <div class="bar-chart-track">
                      <div class="bar-chart-fill" style={`height:${value}%;`} />
                    </div>
                  </div>
                ))
              }
            </div>
            <p class="bar-chart-caption" id="contribution-chart-caption">Share of total fund return, by startup rank (illustrative example)</p>
          </div>
        </div>

        <div class="explainer-step">
          <div class="explainer-text">
            <h3>Diversifying does not change this</h3>
            <p>
              Spread your money evenly, concentrate it in one bet, or split it any other way:
              once the outlier lands, the fund's overall multiple ends up close to the same
              number regardless. This example shows one illustrative draw applied to three
              different allocations. Use the allocator above to see it happen with your own
              numbers.
            </p>
            <p>
              The reason is not that diversifying is pointless, it is that no allocation can
              tell you in advance which startup will be the outlier. Spreading money around
              lowers the chance of missing it entirely, it does not lower how much that one
              company decides the outcome once the draw is made.
            </p>
          </div>
          <div class="explainer-diagram">
            <div class="bar-chart bar-chart-wide" id="strategy-chart">
              {
                STRATEGY_EXAMPLE.map((strategy, i) => (
                  <div class="bar-chart-item">
                    <div class="bar-chart-track">
                      <div class="bar-chart-fill" data-strategy={i} style={`height:${(strategy.value / 1.5) * 100}%;`} />
                    </div>
                    <p class="bar-chart-label" id={`strategy-label-${i}`}>{strategy.label}</p>
                    <p class="bar-chart-value" data-strategy-value={i}>{strategy.value.toFixed(1)}x</p>
                  </div>
                ))
              }
            </div>
            <p class="bar-chart-caption" id="strategy-chart-caption">One illustrative draw applied to three allocations</p>
          </div>
        </div>

        <p class="explainer-conclusion">
          Put together, these three facts are the whole thesis: most bets lose, one outlier
          repays all of them, and no allocation changes that. The only thing left to test is
          whether it holds for your own split.
          <a href="#allocator-form">Try the allocator again ↑</a>
        </p>
      </section>
    </main>

    <footer>
      <details class="info-panel">
        <summary>About this data</summary>
        <p>
          Returns in the allocator above are a modelled Pareto approximation (a mathematical
          shape where a small number of extreme outcomes account for most of the total), not
          real fund or startup data. Parameters are set so most outcomes land near or below 1x with a small
          chance of a 10x+ outlier, broadly matching the aggregate pattern Correlation Ventures
          found across roughly 21,000 US venture financings from 2004 to 2013: around
          two-thirds returned less than the capital invested, and only around 4% returned more
          than 10 times the money. See
          <a href="https://arxiv.org/pdf/2303.11013" target="_blank" rel="noopener noreferrer">
            Awate, "Power-Law Distribution in Venture Capital Returns" (arXiv, 2023)</a>, which
          cites the original Correlation Ventures studies and uses the same shape to parameterise
          a power-law model. The diagrams in "How the power law works" above are illustrative
          examples built to show that same shape, not measurements of this run, except the "One
          outlier carries the fund" chart, which switches to your own result once you invest.
          Startup names, descriptions and icons are fictional, for illustration only.
        </p>
      </details>
    </footer>

    <script
      is:inline
      define:vars={{
        FUND_TOTAL,
        STARTUP_COUNT,
        STEP,
        STARTUP_NAMES: startups.map((s) => s.name),
        STARTUP_COLORS: startups.map((s) => ({ bg: s.bg, accent: s.accent })),
      }}
    >
      const sliders = Array.from(document.querySelectorAll('[data-testid="allocation-slider"]'));
      const outputs = sliders.map((slider) => document.getElementById(`value-${slider.id.split("-")[1]}`));
      const cards = Array.from(document.querySelectorAll(".startup-card"));
      const cardReturns = sliders.map((slider) => document.getElementById(`return-${slider.id.split("-")[1]}`));
      const remainingEl = document.querySelector('[data-testid="fund-remaining"]');
      const promptEl = document.querySelector(".allocation-prompt");
      const submitButton = document.querySelector('[data-testid="allocate-submit"]');
      const returnEl = document.querySelector('[data-testid="fund-return"]');
      const compareEl = document.querySelector(".payoff-compare");
      const breakdownList = document.getElementById("breakdown-list");
      const contributionChart = document.getElementById("contribution-chart");
      const contributionCaption = document.getElementById("contribution-chart-caption");
      const strategyFills = Array.from(document.querySelectorAll("[data-strategy]"));
      const strategyValues = Array.from(document.querySelectorAll("[data-strategy-value]"));
      const strategyCaption = document.getElementById("strategy-chart-caption");
      const strategyLabel2 = document.getElementById("strategy-label-2");
      const form = document.getElementById("allocator-form");
      const randomiseButton = document.getElementById("randomise-button");
      const feeToggle = document.getElementById("fee-info-toggle");
      const feeInfo = document.getElementById("fee-info");

      let allocations = sliders.map((slider) => Number(slider.value));

      const currency = (n) => `$${Math.round(n).toLocaleString("en-AU")}`;

      function remaining() {
        return FUND_TOTAL - allocations.reduce((sum, v) => sum + v, 0);
      }

      // Rounds each allocation to a whole dollar while keeping the sum exactly
      // equal to `total`, by handing the leftover cents to the largest
      // fractional remainders first.
      function largestRemainderRound(values, total) {
        const floors = values.map(Math.floor);
        const used = floors.reduce((a, b) => a + b, 0);
        const remainder = total - used;
        const order = values
          .map((v, i) => ({ i, frac: v - Math.floor(v) }))
          .sort((a, b) => b.frac - a.frac);
        const result = [...floors];
        for (let k = 0; k < remainder; k++) {
          result[order[k % order.length].i] += 1;
        }
        return result;
      }

      // Each control can only take what's left over the fund: its own headroom
      // is its current value plus whatever hasn't been allocated elsewhere.
      // The fund never grows, so submit stays locked until it's fully spent.
      function render() {
        const left = remaining();
        allocations.forEach((value, i) => {
          const slider = sliders[i];
          const cap = value + left;
          slider.max = String(cap);
          slider.value = String(value);
          outputs[i].textContent = currency(value);
        });

        remainingEl.textContent = `Remaining: ${currency(left)}`;

        const fullyAllocated = left === 0;
        remainingEl.classList.toggle("remaining-active", !fullyAllocated);
        submitButton.disabled = !fullyAllocated;
        promptEl.textContent = fullyAllocated
          ? ""
          : `Invest the full ${currency(FUND_TOTAL)} to continue.`;
      }

      // Gives each card back its own colour and clears the last draw's result,
      // since a fresh allocation invalidates the last outcome shown.
      function resetCardColors() {
        cards.forEach((card, i) => {
          card.style.background = STARTUP_COLORS[i].bg;
          card.style.setProperty("--card-accent", STARTUP_COLORS[i].accent);
          card.classList.remove("startup-card-outlier");
          cardReturns[i].textContent = "";
        });
        breakdownList.innerHTML = "";
        returnEl.textContent = "";
        compareEl.textContent = "";
      }

      function setAllocation(index, rawValue) {
        const left = remaining();
        const cap = allocations[index] + left;
        allocations[index] = Math.max(0, Math.min(cap, rawValue));
        resetCardColors();
        render();
      }

      sliders.forEach((slider, i) => {
        slider.addEventListener("input", () => setAllocation(i, Number(slider.value)));
      });

      document.querySelectorAll(".step-btn").forEach((button) => {
        button.addEventListener("click", () => {
          const index = Number(button.dataset.index);
          const direction = button.dataset.action === "increment" ? 1 : -1;
          setAllocation(index, allocations[index] + direction * STEP);
        });
      });

      const resetButton = document.getElementById("reset-button");
      resetButton.addEventListener("click", () => {
        allocations = allocations.map(() => 0);
        resetCardColors();
        render();
      });

      randomiseButton.addEventListener("click", () => {
        // Randomise in whole $100k units, the same step the +/- buttons use,
        // so every random split lands on the same increments a visitor could
        // reach by hand.
        const totalUnits = FUND_TOTAL / STEP;
        const weights = allocations.map(() => Math.random());
        const weightTotal = weights.reduce((a, b) => a + b, 0);
        const scaledUnits = weights.map((w) => (w / weightTotal) * totalUnits);
        const roundedUnits = largestRemainderRound(scaledUnits, totalUnits);
        allocations = roundedUnits.map((units) => units * STEP);
        resetCardColors();
        render();
      });

      feeToggle.addEventListener("click", () => {
        const expanded = feeToggle.getAttribute("aria-expanded") === "true";
        feeToggle.setAttribute("aria-expanded", String(!expanded));
        feeInfo.hidden = expanded;
      });

      // Modelled Pareto approximation, calibrated against the aggregate shape
      // reported in Correlation Ventures' venture outcomes data, not sourced
      // from a real per-deal dataset. Parameters are provisional.
      function drawMultiple() {
        const u = Math.random();
        if (u < 0.65) return Math.random(); // total loss to breakeven
        if (u < 0.9) return 1 + Math.random() * 4; // modest return
        if (u < 0.97) return 5 + Math.random() * 5; // strong return
        const xm = 10;
        const alpha = 1.2;
        const v = Math.random();
        return Math.min(xm / Math.pow(1 - v, 1 / alpha), 300); // power-law outlier tail
      }

      function fundMultiple(amounts, multiples) {
        const total = amounts.reduce((sum, amount, i) => sum + amount * multiples[i], 0);
        return total / FUND_TOTAL;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (remaining() !== 0) return;

        // The same draw is applied to the visitor's split and to two
        // reference strategies, so the comparison isolates the effect of
        // allocation shape rather than re-rolling the outcome.
        const multiples = allocations.map(() => drawMultiple());
        const evenAmounts = allocations.map(() => FUND_TOTAL / allocations.length);
        const concentratedAmounts = allocations.map((_, i) => (i === 0 ? FUND_TOTAL : 0));

        const yourMultiple = fundMultiple(allocations, multiples);
        const evenMultiple = fundMultiple(evenAmounts, multiples);
        const concentratedMultiple = fundMultiple(concentratedAmounts, multiples);

        returnEl.textContent = `${yourMultiple.toFixed(2)}x`;
        compareEl.textContent =
          `Even split: ${evenMultiple.toFixed(2)}x · All in one bet: ${concentratedMultiple.toFixed(2)}x ` +
          `· modelled outcome, not a real fund result.`;

        returnEl.classList.remove("payoff-pop");
        // Force a reflow so the animation class can be re-added on repeat submits.
        void returnEl.offsetWidth;
        returnEl.classList.add("payoff-pop");

        // Per-startup draws: shows which single company actually drove the
        // fund-level number above, rather than leaving the mechanism hidden.
        // Cards converge to the same neutral colour once allocated, since the
        // point is that the split itself doesn't set the outcome apart, only
        // the outlier does — so only that one card stays distinct.
        const outlierIndex = multiples.indexOf(Math.max(...multiples));
        cards.forEach((card, i) => {
          cardReturns[i].textContent = `Returned ${multiples[i].toFixed(2)}x`;
          const isOutlier = i === outlierIndex;
          card.classList.toggle("startup-card-outlier", isOutlier);
          card.style.background = isOutlier ? "var(--outlier-bg)" : "var(--surface)";
          card.style.setProperty("--card-accent", isOutlier ? "var(--outlier-accent)" : "var(--border)");
        });

        const ranked = multiples
          .map((multiple, i) => ({ multiple, name: STARTUP_NAMES[i] }))
          .sort((a, b) => b.multiple - a.multiple);

        breakdownList.innerHTML = "";
        ranked.forEach((entry, rank) => {
          const item = document.createElement("li");
          item.className = "breakdown-item";
          if (rank === 0) item.classList.add("breakdown-item-outlier");
          item.innerHTML = `<span class="breakdown-name">${entry.name}</span><span class="breakdown-multiple">${entry.multiple.toFixed(2)}x</span>`;
          breakdownList.appendChild(item);
        });

        // Swaps the illustrative "one outlier carries the fund" chart for the
        // visitor's own result, since a live number makes the point better
        // than a static example once one is available.
        const dollarReturns = allocations.map((amount, i) => amount * multiples[i]);
        const totalDollarReturn = dollarReturns.reduce((a, b) => a + b, 0);
        const shares =
          totalDollarReturn > 0
            ? dollarReturns.map((value) => (value / totalDollarReturn) * 100).sort((a, b) => b - a)
            : dollarReturns.map(() => 0);

        contributionChart.innerHTML = "";
        shares.forEach((share) => {
          const item = document.createElement("div");
          item.className = "bar-chart-item";
          item.innerHTML = `<div class="bar-chart-track"><div class="bar-chart-fill" style="height:${share}%;"></div></div>`;
          contributionChart.appendChild(item);
        });
        contributionCaption.textContent = "Share of your fund's actual return, by startup rank";

        // Swaps the illustrative "diversifying does not change this" chart
        // for the same draw applied to your actual split, since it is
        // already computed above for the headline comparison line.
        const strategyResults = [concentratedMultiple, evenMultiple, yourMultiple];
        const scale = Math.max(1.5, ...strategyResults);
        strategyFills.forEach((fill, i) => {
          fill.style.height = `${(strategyResults[i] / scale) * 100}%`;
        });
        strategyValues.forEach((el, i) => {
          el.textContent = `${strategyResults[i].toFixed(2)}x`;
        });
        strategyLabel2.textContent = "Your split";
        strategyCaption.textContent = "This draw applied to three allocations, including yours";
      });

      render();

      // Tail-heaviness slider for the explainer diagram: reshapes the four
      // illustrative bucket percentages so they always sum to 100, from the
      // static low-tail values up to a much fatter tail at the high end.
      const tailSlider = document.getElementById("tail-slider");
      const tailSliderValue = document.getElementById("tail-slider-value");
      const tailFills = Array.from(document.querySelectorAll("[data-bucket]"));
      const tailValues = Array.from(document.querySelectorAll("[data-bucket-value]"));

      function tailBuckets(t) {
        return [65 - 30 * t, 25 - 5 * t, 7, 3 + 35 * t];
      }

      function updateTailSlider() {
        const t = Number(tailSlider.value) / 100;
        const buckets = tailBuckets(t);
        tailFills.forEach((fill, i) => {
          fill.style.height = `${buckets[i]}%`;
        });
        tailValues.forEach((el, i) => {
          el.textContent = `${Math.round(buckets[i])}%`;
        });
        tailSliderValue.textContent = t < 0.34 ? "mild" : t < 0.67 ? "heavy" : "extreme";
        tailSlider.style.background = `linear-gradient(to right, var(--accent) ${t * 100}%, var(--track) ${t * 100}%)`;
      }

      tailSlider.addEventListener("input", updateTailSlider);
      updateTailSlider();
    </script>
  </body>
</html>
