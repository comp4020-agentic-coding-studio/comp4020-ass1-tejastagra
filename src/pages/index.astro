---
import "../../styles.css";

const RAISED_TOTAL = 12_500_000;
const FUND_TOTAL = 10_000_000;
const STARTUP_COUNT = 15;
const STEP = 100_000;

const STARTUP_INFO = [
  { name: "Orbital Analytics", description: "Satellite imagery for crop insurers" },
  { name: "Loopwave", description: "Recycled battery chemistry for EVs" },
  { name: "Fernway Health", description: "Remote diagnostics for rural clinics" },
  { name: "Cursive AI", description: "Handwriting-to-text for legal filings" },
  { name: "Driftline", description: "Autonomous freight barges" },
  { name: "Solstice Grid", description: "Community solar microgrids" },
  { name: "Nomad Labs", description: "Modular housing for disaster relief" },
  { name: "Verdant Foods", description: "Lab-grown fibre for meat alternatives" },
  { name: "Pathwell", description: "Mental health triage chatbot" },
  { name: "Anchor Robotics", description: "Warehouse picking robots" },
  { name: "Cinderpoint", description: "Wildfire early-detection sensors" },
  { name: "Marrow Bio", description: "Bone marrow donor matching platform" },
  { name: "Tallyworks", description: "Small business bookkeeping automation" },
  { name: "Skyloom", description: "Drone-based crop spraying" },
  { name: "Undertone", description: "Noise-cancelling hearing aids" },
];

// A small, muted palette reused across cards (lawsofux.com-style flat colour
// blocks), paired with a lighter/darker tint for the motif drawn on top.
const PALETTE = [
  { name: "navy", bg: "#28344a", fg: "#aebbd6" },
  { name: "teal", bg: "#1f6e64", fg: "#9fd6cc" },
  { name: "terracotta", bg: "#c1613f", fg: "#f0b79a" },
  { name: "purple", bg: "#5d4b7a", fg: "#c7b8e0" },
  { name: "cream", bg: "#ede3c8", fg: "#8a7a4e" },
];

// Reusable abstract motifs, each a function of a foreground colour, drawn in
// a 240x120 viewBox so they fill a wide full-bleed block at the card's top.
const MOTIFS = [
  // dot grid
  (fg: string) => {
    let dots = "";
    for (let row = 0; row < 3; row++) {
      for (let col = 0; col < 7; col++) {
        const cx = 18 + col * 34 + (row % 2 === 1 ? 17 : 0);
        const cy = 20 + row * 40;
        const opacity = col % 3 === 0 ? 1 : 0.5;
        dots += `<circle cx="${cx}" cy="${cy}" r="8" fill="${fg}" opacity="${opacity}"/>`;
      }
    }
    return dots;
  },
  // circle and triangle overlap
  (fg: string) =>
    `<circle cx="75" cy="65" r="55" fill="${fg}" opacity="0.85"/><polygon points="150,10 232,120 95,120" fill="${fg}" opacity="0.55"/>`,
  // vertical stripes
  (fg: string) => {
    let stripes = "";
    for (let i = 0; i < 7; i++) {
      const opacity = i % 2 === 0 ? 0.9 : 0.4;
      stripes += `<rect x="${i * 34}" y="0" width="17" height="120" fill="${fg}" opacity="${opacity}"/>`;
    }
    return stripes;
  },
  // concentric circles
  (fg: string) =>
    `<circle cx="120" cy="60" r="52" fill="none" stroke="${fg}" stroke-width="9" opacity="0.9"/><circle cx="120" cy="60" r="36" fill="none" stroke="${fg}" stroke-width="9" opacity="0.65"/><circle cx="120" cy="60" r="20" fill="none" stroke="${fg}" stroke-width="9" opacity="0.4"/>`,
];

const startups = STARTUP_INFO.slice(0, STARTUP_COUNT).map((info, i) => {
  const palette = PALETTE[i % PALETTE.length];
  const motif = MOTIFS[i % MOTIFS.length];
  return {
    id: i + 1,
    name: info.name,
    description: info.description,
    blockBg: palette.bg,
    accent: palette.bg,
    artwork: motif(palette.fg),
    initial: 0,
  };
});

// Illustrative diagrams for the explainer section below: static example
// figures that show the shape of the power law, not live simulation output.
const OUTCOME_BUCKETS = [
  { label: "0 to 1x", value: 65 },
  { label: "1 to 5x", value: 25 },
  { label: "5 to 10x", value: 7 },
  { label: "10x or more", value: 3 },
];

const CONTRIBUTION_EXAMPLE = [70, 7, 5, 4, 3, 2, 2, 1.5, 1.5, 1, 1, 0.8, 0.7, 0.3, 0.2];

const STRATEGY_EXAMPLE = [
  { label: "One concentrated bet", value: 1.3 },
  { label: "Even split", value: 1.2 },
  { label: "A typical mixed split", value: 1.1 },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="Primary">
      <a href="#main-content" class="visually-hidden">Skip to main content</a>
    </nav>
    <main id="main-content">
      <p class="eyebrow">A venture fund investment simulator</p>
      <h1>The power law simulator</h1>
      <p class="intro">
        A "venture fund" is a pool of money that professional investors put into young,
        unproven companies ("startups") in exchange for a stake in each one. Most startups fail
        or barely survive. A venture fund makes money anyway, because occasionally one of its
        startups becomes huge, and that single success pays for all the failures many times
        over. This page walks through how that actually plays out. You play fund manager: split
        a fixed pool of money across {STARTUP_COUNT} startups, then see what comes back.
      </p>
      <p class="framing">
        This fund raised ${RAISED_TOTAL.toLocaleString("en-AU")}. Fees take about 20% over its
        life. That leaves <strong data-testid="fund-total">${FUND_TOTAL.toLocaleString("en-AU")}</strong> to
        invest in {STARTUP_COUNT} startups. However you split it, one outlier (a single
        startup that returns far more than the rest) decides almost all of your return.
        <button type="button" class="info-toggle" id="fee-info-toggle" aria-expanded="false" aria-controls="fee-info">
          Why only 80%?
        </button>
      </p>
      <div id="fee-info" class="fee-info">
        <p>
          Funds typically charge a management fee of roughly 2% each year, charged across roughly ten
          years, to cover salaries and other running costs. That works out to about 20% of the
          ${RAISED_TOTAL.toLocaleString("en-AU")} raised, leaving roughly ${FUND_TOTAL.toLocaleString("en-AU")} to
          actually invest in startups.
        </p>
      </div>

      <form id="allocator-form">
        <div class="allocation-sticky-region">
          <div class="sticky-toolbar">
            <div class="remaining-bar">
              <p data-testid="fund-remaining" aria-live="polite" class="remaining-number">
                Remaining: ${FUND_TOTAL.toLocaleString("en-AU")}
              </p>
              <p class="allocation-prompt" aria-live="polite">
                Invest the full ${FUND_TOTAL.toLocaleString("en-AU")} to continue.
              </p>
            </div>
          </div>
          <div class="grid-controls">
            <button type="button" id="reset-button" class="randomise-button">Reset</button>
            <button type="button" id="randomise-button" class="randomise-button">
              Randomise: invest all ${FUND_TOTAL.toLocaleString("en-AU")}
            </button>
          </div>
          <ul class="startup-grid">
          {
            startups.map((startup) => (
              <li class="startup-card" style={`--card-accent:${startup.accent};`}>
                <div
                  class="card-header"
                  style={`background:${startup.blockBg};`}
                  aria-hidden="true"
                  set:html={`<svg viewBox="0 0 240 120" preserveAspectRatio="xMidYMid slice">${startup.artwork}</svg>`}
                />
                <div class="card-body">
                  <p class="startup-name">{startup.name}</p>
                  <p class="startup-description">{startup.description}</p>
                  <p class="card-return" id={`return-${startup.id}`} aria-live="polite"></p>
                  <div class="stepper">
                    <button
                      type="button"
                      class="step-btn"
                      data-action="decrement"
                      data-index={startup.id - 1}
                      aria-label={`Decrease allocation for ${startup.name}`}
                    >
                      &minus;
                    </button>
                    <output for={`slider-${startup.id}`} id={`value-${startup.id}`}>
                      ${startup.initial.toLocaleString("en-AU")}
                    </output>
                    <button
                      type="button"
                      class="step-btn"
                      data-action="increment"
                      data-index={startup.id - 1}
                      aria-label={`Increase allocation for ${startup.name}`}
                    >
                      &plus;
                    </button>
                  </div>
                  <input
                    type="range"
                    id={`slider-${startup.id}`}
                    name={`slider-${startup.id}`}
                    data-testid="allocation-slider"
                    data-index={startup.id - 1}
                    class="visually-hidden"
                    tabindex="-1"
                    aria-hidden="true"
                    min="0"
                    max={FUND_TOTAL}
                    step="10000"
                    value={startup.initial}
                  />
                </div>
              </li>
            ))
          }
          </ul>
        </div>

        <button type="submit" data-testid="allocate-submit" class="allocate-button">Invest</button>
      </form>

      <section class="payoff">
        <p data-testid="fund-return" class="payoff-number" aria-live="polite"></p>
        <p class="payoff-compare"></p>
      </section>

      <section class="breakdown" id="breakdown" hidden>
        <h2>Startup returns, ranked</h2>
        <p class="breakdown-caption">
          This is the same draw as above, one circle per startup, sized by how much it returned.
          The biggest circle is the one that actually made your fund's money.
        </p>
        <div class="bubble-chart" id="bubble-chart"></div>
      </section>

      <section class="explainer" id="explainer">
        <h2>How the power law works</h2>
        <p class="explainer-intro">
          A "return multiple" is what a fund gets back for every dollar it invests: a 2x means
          the money doubled, a 0.3x means most of it was lost. A "power law" here just means
          that a few results are enormously bigger than all the rest put together, rather than
          outcomes clustering around an average. Venture funds live and die by that one fact.
        </p>
        <p class="explainer-intro">
          When you click "Invest" in the simulator above, the site does "the draw": it randomly
          picks a return multiple for each startup from a distribution shaped like the one below,
          then adds up what your money invested in each one turned into. That is what produces
          the fund return you see, and it is why the same allocation can turn out very
          differently each time you invest.
        </p>

        <div class="explainer-step">
          <div class="explainer-text">
            <h3>Most bets return less than they cost</h3>
            <p>
              Across a large number of venture deals, most return less than the money put in.
              A modest share do well. Only a small slice return ten times or more. Statisticians
              call this shape "fat-tailed": a lot of small losses, and a few enormous wins far
              out in the "tail" of the distribution. It is the reason a single startup can end
              up mattering more than the other fourteen in this fund combined.
            </p>
            <p>
              "Tail heaviness" describes how extreme those rare wins are. A low tail means the
              biggest winners are only modestly larger than everything else. A high tail means
              almost every startup fails or breaks even, but the rare one that works pays back
              dozens of times its cost, which is closer to how real venture returns behave. Drag
              the slider to move from a low tail to a high tail and watch the bars reshape: the
              loss and modest-return bars shrink while the rare, huge-return bar grows. This is
              an illustrative model, not a measurement of real deals.
            </p>
          </div>
          <div class="explainer-diagram">
            <div class="bar-chart" id="tail-bar-chart">
              {
                OUTCOME_BUCKETS.map((bucket, i) => (
                  <div class="bar-chart-item">
                    <div class="bar-chart-track">
                      <div class="bar-chart-fill" data-bucket={i} style={`height:${bucket.value}%;`} />
                    </div>
                    <p class="bar-chart-label">{bucket.label}</p>
                    <p class="bar-chart-value" data-bucket-value={i}>{bucket.value}%</p>
                  </div>
                ))
              }
            </div>
            <label class="tail-slider-label" for="tail-slider">
              Tail heaviness: <span id="tail-slider-value">mild</span>
            </label>
            <input type="range" id="tail-slider" min="0" max="100" value="0" step="1" />
            <div class="tail-slider-scale">
              <span>Mild</span>
              <span>Extreme</span>
            </div>
          </div>
        </div>

        <div class="explainer-step">
          <div class="explainer-text">
            <h3>One outlier carries the fund</h3>
            <p>
              Rank a fund's startups by how much each one contributes to the total money
              returned. In a typical outcome, one of them accounts for most of it and the rest
              barely register, a single "outlier" carrying the whole fund.
            </p>
            <p id="contribution-caption">
              This example ranks {STARTUP_COUNT} illustrative startups by contribution: the
              tallest bar alone is worth more than all the others combined. Invest your own fund
              above and this chart will switch to showing your actual result instead.
            </p>
          </div>
          <div class="explainer-diagram">
            <div class="bar-chart bar-chart-tight" id="contribution-chart">
              {
                CONTRIBUTION_EXAMPLE.map((value) => (
                  <div class="bar-chart-item">
                    <div class="bar-chart-track">
                      <div class="bar-chart-fill" style={`height:${value}%;`} />
                    </div>
                  </div>
                ))
              }
            </div>
            <p class="bar-chart-caption" id="contribution-chart-caption">Share of total fund return, by startup rank (illustrative example)</p>
          </div>
        </div>

        <div class="explainer-step">
          <div class="explainer-text">
            <h3>Diversifying does not change this</h3>
            <p>
              Spread your money evenly, concentrate it on one company, or split it any other
              way: none of these tell you in advance which startup will be the outlier. This
              example shows one illustrative draw applied to three allocations, a random
              concentrated bet, an even split, and a typical mixed split. Use the simulator
              above to see it happen with your own numbers.
            </p>
            <p>
              The reason is not that diversifying is pointless, it is that no allocation can
              tell you in advance which startup will be the outlier. Spreading money around
              lowers the chance of missing it entirely, it does not lower how much that one
              company decides the outcome once the draw is made.
            </p>
          </div>
          <div class="explainer-diagram">
            <div class="bar-chart bar-chart-wide" id="strategy-chart">
              {
                STRATEGY_EXAMPLE.map((strategy, i) => (
                  <div class="bar-chart-item">
                    <div class="bar-chart-track">
                      <div class="bar-chart-fill" data-strategy={i} style={`height:${(strategy.value / 1.5) * 100}%;`} />
                    </div>
                    <p class="bar-chart-label" id={`strategy-label-${i}`}>{strategy.label}</p>
                    <p class="bar-chart-value" data-strategy-value={i}>{strategy.value.toFixed(1)}x</p>
                  </div>
                ))
              }
            </div>
            <p class="bar-chart-caption" id="strategy-chart-caption">One illustrative draw applied to three allocations</p>
          </div>
        </div>

        <p class="explainer-conclusion">
          Put together, these three facts are the whole thesis: most bets lose, one outlier
          repays all of them, and no allocation changes that. The only thing left to test is
          whether it holds for your own split.
          <a href="#allocator-form">Try the simulator again ↑</a>
        </p>
      </section>
    </main>

    <aside class="author-panel" id="author-panel" aria-hidden="true">
      <button type="button" class="author-panel-close" id="author-panel-close" aria-label="Dismiss">
        &times;
      </button>
      <p>
        Enjoyed reading this? The author of this piece,
        <a href="https://www.linkedin.com/in/tejastagra" target="_blank" rel="noopener noreferrer"
          >Tejas Tagra</a
        >, also works in venture capital. Connect with him on
        <a href="https://www.linkedin.com/in/tejastagra" target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        > for more insights like this.
      </p>
    </aside>

    <footer>
      <details class="info-panel">
        <summary>About this data</summary>
        <p>
          Returns in the simulator above are a modelled Pareto approximation (a mathematical
          shape where a small number of extreme outcomes account for most of the total), not
          real fund or startup data. Parameters are set so most outcomes land near or below 1x with a small
          chance of a 10x+ outlier, broadly matching the aggregate pattern Correlation Ventures
          found across roughly 21,000 US venture financings from 2004 to 2013: around
          two-thirds returned less than the capital invested, and only around 4% returned more
          than 10 times the money. See
          <a href="https://arxiv.org/pdf/2303.11013" target="_blank" rel="noopener noreferrer">
            Awate, "Power-Law Distribution in Venture Capital Returns" (arXiv, 2023)</a>, which
          cites the original Correlation Ventures studies and uses the same shape to parameterise
          a power-law model. The diagrams in "How the power law works" above are illustrative
          examples built to show that same shape, not measurements of this run, except the "One
          outlier carries the fund" chart, which switches to your own result once you invest.
          Startup names, descriptions and artwork are fictional, for illustration only.
        </p>
      </details>
    </footer>

    <p class="disclaimer">
      <span aria-hidden="true">⚠️</span>
      This page does not constitute financial, legal or tax advice, and should not be relied upon
      as a solicitation or offer to invest. It is for educational purposes only. Venture
      investments carry significant risk.
    </p>

    <script
      is:inline
      define:vars={{
        FUND_TOTAL,
        STARTUP_COUNT,
        STEP,
        STARTUP_NAMES: startups.map((s) => s.name),
        STARTUP_ACCENTS: startups.map((s) => s.accent),
      }}
    >
      const sliders = Array.from(document.querySelectorAll('[data-testid="allocation-slider"]'));
      const outputs = sliders.map((slider) => document.getElementById(`value-${slider.id.split("-")[1]}`));
      const cards = Array.from(document.querySelectorAll(".startup-card"));
      const cardReturns = sliders.map((slider) => document.getElementById(`return-${slider.id.split("-")[1]}`));
      const remainingBar = document.querySelector(".remaining-bar");
      const remainingEl = document.querySelector('[data-testid="fund-remaining"]');
      const promptEl = document.querySelector(".allocation-prompt");
      const submitButton = document.querySelector('[data-testid="allocate-submit"]');
      const returnEl = document.querySelector('[data-testid="fund-return"]');
      const compareEl = document.querySelector(".payoff-compare");
      const bubbleChart = document.getElementById("bubble-chart");
      const breakdownSection = document.getElementById("breakdown");
      let bubbleChartState = null;
      const contributionChart = document.getElementById("contribution-chart");
      const contributionCaption = document.getElementById("contribution-chart-caption");
      const strategyFills = Array.from(document.querySelectorAll("[data-strategy]"));
      const strategyValues = Array.from(document.querySelectorAll("[data-strategy-value]"));
      const strategyCaption = document.getElementById("strategy-chart-caption");
      const strategyLabel2 = document.getElementById("strategy-label-2");
      const form = document.getElementById("allocator-form");
      const randomiseButton = document.getElementById("randomise-button");
      const feeToggle = document.getElementById("fee-info-toggle");
      const feeInfo = document.getElementById("fee-info");

      let allocations = sliders.map((slider) => Number(slider.value));

      const currency = (n) => `$${Math.round(n).toLocaleString("en-AU")}`;

      function remaining() {
        return FUND_TOTAL - allocations.reduce((sum, v) => sum + v, 0);
      }

      // Rounds each allocation to a whole dollar while keeping the sum exactly
      // equal to `total`, by handing the leftover cents to the largest
      // fractional remainders first.
      function largestRemainderRound(values, total) {
        const floors = values.map(Math.floor);
        const used = floors.reduce((a, b) => a + b, 0);
        const remainder = total - used;
        const order = values
          .map((v, i) => ({ i, frac: v - Math.floor(v) }))
          .sort((a, b) => b.frac - a.frac);
        const result = [...floors];
        for (let k = 0; k < remainder; k++) {
          result[order[k % order.length].i] += 1;
        }
        return result;
      }

      // Each control can only take what's left over the fund: its own headroom
      // is its current value plus whatever hasn't been allocated elsewhere.
      // The fund never grows, so submit stays locked until it's fully spent.
      function render() {
        const left = remaining();
        allocations.forEach((value, i) => {
          const slider = sliders[i];
          const cap = value + left;
          slider.max = String(cap);
          slider.value = String(value);
          outputs[i].textContent = currency(value);

          // The graphic (not the card box) scales and saturates with how much
          // is invested, clipped inside the card's fixed-size header block so
          // the grid never reflows. A fractional power curve (not linear)
          // means the first click already reads as a visible jump, while $0
          // stays calm and the full-fund case still lands at the top of the
          // range.
          const weight = Math.pow(value / FUND_TOTAL, 0.35);
          cards[i].style.setProperty("--art-scale", (1 + weight * 0.6).toFixed(3));
          cards[i].style.setProperty("--art-saturate", (1 + weight * 1.2).toFixed(3));
        });

        remainingEl.textContent = `Remaining: ${currency(left)}`;

        const fullyAllocated = left === 0;
        remainingEl.classList.toggle("remaining-active", !fullyAllocated);
        submitButton.disabled = !fullyAllocated;
        promptEl.textContent = fullyAllocated
          ? ""
          : `Invest the full ${currency(FUND_TOTAL)} to continue.`;
      }

      // Gives each card back its own colour and clears the last draw's result,
      // since a fresh allocation invalidates the last outcome shown.
      function resetCardColors() {
        remainingBar.hidden = false;
        cards.forEach((card, i) => {
          card.style.setProperty("--card-accent", STARTUP_ACCENTS[i]);
          card.classList.remove("startup-card-outlier");
          const header = card.querySelector(".card-header");
          header.classList.remove("card-header-dimmed");
          header.classList.remove("card-header-pulse");
          cardReturns[i].textContent = "";
        });
        bubbleChart.innerHTML = "";
        breakdownSection.hidden = true;
        bubbleChartState = null;
        dragCtx = null;
        returnEl.textContent = "";
        compareEl.textContent = "";
      }

      // Text metrics for sizing circles so a startup's name and multiple
      // always fit without truncation, however small its return is.
      const bubbleMeasureCtx = document.createElement("canvas").getContext("2d");
      const NAME_FONT = 12;
      const MULT_FONT = 10.5;
      const LABEL_PAD = 6;

      function measureLineWidth(ctx, text, fontPx) {
        ctx.font = `${fontPx}px system-ui, sans-serif`;
        return ctx.measureText(text).width;
      }

      // Stacks the given lines centred vertically around 0 and returns each
      // line's vertical offset (dy) alongside the block's total height.
      function layoutLines(lines) {
        const heights = lines.map((l) => l.fontSize * 1.25);
        const totalHeight = heights.reduce((a, b) => a + b, 0);
        let cursor = -totalHeight / 2;
        const placed = lines.map((l, i) => {
          const lh = heights[i];
          const dy = cursor + lh / 2;
          cursor += lh;
          return { ...l, dy };
        });
        return { lines: placed, totalHeight };
      }

      // Tries the name on one line, then every two-line word-wrap split, and
      // keeps whichever needs the smallest circle to hold it without
      // truncation — that smallest-possible radius is this startup's
      // legibility floor.
      function computeLabel(ctx, name, multipleText) {
        const words = name.split(" ");
        const nameLineOptions = [[name]];
        for (let k = 1; k < words.length; k++) {
          nameLineOptions.push([words.slice(0, k).join(" "), words.slice(k).join(" ")]);
        }

        let best = null;
        nameLineOptions.forEach((nameLines) => {
          const rawLines = [
            ...nameLines.map((text) => ({ text, className: "bubble-label-name", fontSize: NAME_FONT })),
            { text: multipleText, className: "bubble-label-multiple", fontSize: MULT_FONT },
          ];
          const { lines, totalHeight } = layoutLines(rawLines);
          const maxWidth = Math.max(...lines.map((l) => measureLineWidth(ctx, l.text, l.fontSize)));
          const r = Math.hypot(maxWidth / 2, totalHeight / 2) + LABEL_PAD;
          if (!best || r < best.r) best = { lines, r };
        });
        return best;
      }

      // Small circles can be too tight to hold a name and multiple without
      // truncation — the true size difference is the point, not label
      // legibility, so those get a compact single-line label just outside
      // the circle instead of forcing the circle to grow.
      const OUTSIDE_FONT = 9.5;
      const OUTSIDE_MAX_WIDTH = 108;

      function computeOutsideLabelText(ctx, name, multipleText) {
        const full = `${name} ${multipleText}`;
        if (measureLineWidth(ctx, full, OUTSIDE_FONT) <= OUTSIDE_MAX_WIDTH) return full;
        let truncated = name;
        while (truncated.length > 1) {
          truncated = truncated.slice(0, -1);
          const candidate = `${truncated}… ${multipleText}`;
          if (measureLineWidth(ctx, candidate, OUTSIDE_FONT) <= OUTSIDE_MAX_WIDTH) return candidate;
        }
        return multipleText;
      }

      // Two circles of radius r1/r2 centred at (x1,y1)/(x2,y2): the up-to-two
      // points sitting at distance r1 from the first and r2 from the second —
      // the candidate spots where a new circle can sit tangent to both at once.
      function circleIntersections(x1, y1, r1, x2, y2, r2) {
        const dx = x2 - x1;
        const dy = y2 - y1;
        const d = Math.hypot(dx, dy);
        if (d === 0 || d > r1 + r2 || d < Math.abs(r1 - r2)) return [];
        const a = (r1 * r1 - r2 * r2 + d * d) / (2 * d);
        const hSq = r1 * r1 - a * a;
        if (hSq < 0) return [];
        const h = Math.sqrt(Math.max(0, hSq));
        const mx = x1 + (a * dx) / d;
        const my = y1 + (a * dy) / d;
        return [
          { x: mx + (h * dy) / d, y: my - (h * dx) / d },
          { x: mx - (h * dy) / d, y: my + (h * dx) / d },
        ];
      }

      function isValidCirclePlacement(point, r, placed) {
        return placed.every((o) => Math.hypot(point.x - o.x, point.y - o.y) >= o.r + r - 0.5);
      }

      // Fallback for when no pair of already-placed circles offers a valid
      // tangent point (eg only one circle placed so far): walks the compass
      // around the nearest circle and keeps the first open, non-overlapping angle.
      function placeTangentToNearest(item, placed, aspectX) {
        let best = null;
        placed.forEach((o) => {
          for (let k = 0; k < 32; k++) {
            const angle = (k / 32) * Math.PI * 2;
            const dist = o.r + item.r;
            const point = { x: o.x + Math.cos(angle) * dist, y: o.y + Math.sin(angle) * dist };
            if (!isValidCirclePlacement(point, item.r, placed)) continue;
            const cost = Math.hypot(point.x / aspectX, point.y);
            if (!best || cost < best.cost) best = { x: point.x, y: point.y, cost };
          }
        });
        item.x = best ? best.x : 0;
        item.y = best ? best.y : 0;
      }

      // Greedy circle packing: the biggest circle goes first, then every
      // later circle (largest to smallest) is placed tangent to whichever
      // pair of already-placed circles gives a valid, non-overlapping spot
      // closest to the growing cluster — so every circle ends up touching at
      // least one other, with no grid or column structure and no dead space.
      // aspectX biases candidates towards a wider-than-tall cluster, matching
      // how much horizontal room the chart actually has.
      function packCirclesCluster(items, aspectX) {
        const placed = [];
        items.forEach((item, i) => {
          if (i === 0) {
            item.x = 0;
            item.y = 0;
          } else if (i === 1) {
            item.x = placed[0].r + item.r;
            item.y = 0;
          } else {
            let best = null;
            for (let a = 0; a < placed.length; a++) {
              for (let b = a + 1; b < placed.length; b++) {
                const A = placed[a];
                const B = placed[b];
                const candidates = circleIntersections(A.x, A.y, A.r + item.r, B.x, B.y, B.r + item.r);
                candidates.forEach((point) => {
                  if (!isValidCirclePlacement(point, item.r, placed)) return;
                  const cost = Math.hypot(point.x / aspectX, point.y);
                  if (!best || cost < best.cost) best = { x: point.x, y: point.y, cost };
                });
              }
            }
            if (best) {
              item.x = best.x;
              item.y = best.y;
            } else {
              placeTangentToNearest(item, placed, aspectX);
            }
          }
          placed.push(item);
        });
      }

      // Draws each startup as a circle whose area is strictly proportional to
      // its return multiple, no minimum floor — the true size difference
      // between a near-total-loss and the outlier is the whole point. Circles
      // are packed into one connected cluster (packCirclesCluster) rather
      // than a grid, then the whole cluster is scaled as one so the biggest
      // circle always fits on screen with room to spare.
      function renderBubbleChart(multiples) {
        const svgNS = "http://www.w3.org/2000/svg";
        const width = Math.max(240, bubbleChart.clientWidth || 800);
        const pad = 20;

        // Natural, pre-fit radii: area proportional to the return multiple.
        // The 1.5px floor just keeps a near-zero multiple visible as a dot —
        // it's not sized for label legibility.
        const circles = multiples.map((multiple, i) => ({
          index: i,
          name: STARTUP_NAMES[i],
          multiple,
          r: Math.max(1.5, Math.sqrt(Math.max(0, multiple)) * 18),
        }));

        const sorted = [...circles].sort((a, b) => b.r - a.r);
        const aspectX = Math.min(3, Math.max(1, width / 450));
        packCirclesCluster(sorted, aspectX);

        const rawMinX = Math.min(...sorted.map((c) => c.x - c.r));
        const rawMaxX = Math.max(...sorted.map((c) => c.x + c.r));
        const packedWidth = rawMaxX - rawMinX;
        const availableWidth = Math.max(1, width - pad * 2);

        // Fit the whole cluster to the available width: shrink it if the
        // natural pack would overflow (this is what keeps the dominant
        // circle fully on screen even for an extreme draw), or grow it —
        // capped — to use the space when the draw is low-variance and the
        // natural pack is small. Either way every circle's relative size
        // stays exactly proportional, since the same factor scales them all.
        const MAX_UPSCALE = 2.4;
        const scale =
          packedWidth > availableWidth ? availableWidth / packedWidth : Math.min(MAX_UPSCALE, availableWidth / packedWidth);
        sorted.forEach((c) => {
          c.x *= scale;
          c.y *= scale;
          c.r *= scale;
        });

        const maxMultiple = Math.max(...multiples);

        // Labels are measured in real (unscaled-by-us) pixels, so a small
        // circle's outside label can stick out sideways further than the
        // circle itself — recompute the labels and the label-inclusive
        // bounding box, and if that's still wider than the available width,
        // fold in one more uniform shrink so the labels themselves never push
        // a circle's own edge past the viewport.
        let labels;
        let minX;
        let maxX;
        let minY;
        let maxY;
        for (let pass = 0; pass < 3; pass++) {
          labels = sorted.map((c) => {
            const inside = computeLabel(bubbleMeasureCtx, c.name, `${c.multiple.toFixed(2)}x`);
            if (inside.r <= c.r) return { outside: false, lines: inside.lines };
            const text = computeOutsideLabelText(bubbleMeasureCtx, c.name, `${c.multiple.toFixed(2)}x`);
            return { outside: true, text, width: measureLineWidth(bubbleMeasureCtx, text, OUTSIDE_FONT) };
          });

          minX = Infinity;
          maxX = -Infinity;
          minY = Infinity;
          maxY = -Infinity;
          sorted.forEach((c, i) => {
            const label = labels[i];
            const left = label.outside ? c.x - Math.max(c.r, label.width / 2 + 4) : c.x - c.r;
            const right = label.outside ? c.x + Math.max(c.r, label.width / 2 + 4) : c.x + c.r;
            const bottom = label.outside ? c.y + c.r + 12 + OUTSIDE_FONT : c.y + c.r;
            minX = Math.min(minX, left);
            maxX = Math.max(maxX, right);
            minY = Math.min(minY, c.y - c.r);
            maxY = Math.max(maxY, bottom);
          });

          const footprintWidth = maxX - minX;
          if (footprintWidth <= availableWidth) break;
          const extraShrink = availableWidth / footprintWidth;
          sorted.forEach((c) => {
            c.x *= extraShrink;
            c.y *= extraShrink;
            c.r *= extraShrink;
          });
        }

        const shiftX = pad - minX + Math.max(0, (availableWidth - (maxX - minX)) / 2);
        const shiftY = pad - minY;
        sorted.forEach((c) => {
          c.x += shiftX;
          c.y += shiftY;
        });
        const height = maxY - minY + pad * 2;

        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
        svg.setAttribute("width", String(width));
        svg.setAttribute("height", String(height));
        svg.setAttribute("role", "img");
        svg.setAttribute(
          "aria-label",
          "Circle-packing chart, draggable: each circle's area is the startup's return multiple, and the biggest circle dominates the fund's return.",
        );

        const items = Array.from({ length: circles.length });
        sorted.forEach((c, i) => {
          const isOutlier = c.multiple === maxMultiple;
          const label = labels[i];
          const g = document.createElementNS(svgNS, "g");
          g.setAttribute("class", isOutlier ? "bubble bubble-outlier" : "bubble");
          g.dataset.index = String(c.index);

          const circleEl = document.createElementNS(svgNS, "circle");
          circleEl.setAttribute("cx", String(c.x));
          circleEl.setAttribute("cy", String(c.y));
          circleEl.setAttribute("r", String(c.r));
          g.appendChild(circleEl);

          const title = document.createElementNS(svgNS, "title");
          title.textContent = `${c.name}: ${c.multiple.toFixed(2)}x`;
          g.appendChild(title);

          let labelEls;
          if (label.outside) {
            const dy = c.r + 12;
            const textEl = document.createElementNS(svgNS, "text");
            textEl.setAttribute("x", String(c.x));
            textEl.setAttribute("y", String(c.y + dy));
            textEl.setAttribute("class", "bubble-label-outside");
            textEl.setAttribute("font-size", String(OUTSIDE_FONT));
            textEl.textContent = label.text;
            g.appendChild(textEl);
            labelEls = [{ el: textEl, dy }];
          } else {
            labelEls = label.lines.map((line) => {
              const textEl = document.createElementNS(svgNS, "text");
              textEl.setAttribute("x", String(c.x));
              textEl.setAttribute("y", String(c.y + line.dy));
              textEl.setAttribute("class", line.className);
              textEl.setAttribute("font-size", String(line.fontSize));
              textEl.textContent = line.text;
              g.appendChild(textEl);
              return { el: textEl, dy: line.dy };
            });
          }

          svg.appendChild(g);
          items[c.index] = {
            el: circleEl,
            r: c.r,
            x: c.x,
            y: c.y,
            restX: c.x,
            restY: c.y,
            labelEls,
            amp: 2 + Math.random() * 2.5,
            freq1: 0.35 + Math.random() * 0.35,
            freq2: 0.3 + Math.random() * 0.35,
            phase1: Math.random() * Math.PI * 2,
            phase2: Math.random() * Math.PI * 2,
          };
        });

        bubbleChart.innerHTML = "";
        bubbleChart.appendChild(svg);
        bubbleChartState = { items, width, height, pad };
        startBubbleAnimation();
      }

      // Dragging: a soft, non-physical collision pass so the grabbed circle
      // always follows the pointer exactly, while any circle it's dragged
      // into gets pushed clear (and circles never overlap each other either).
      let dragCtx = null;

      function chartPointFromEvent(svg, event) {
        const rect = svg.getBoundingClientRect();
        const scale = bubbleChartState.width / rect.width;
        return { x: (event.clientX - rect.left) * scale, y: (event.clientY - rect.top) * scale };
      }

      function resolveBubbleCollisions(items, draggedIndex, width, height, pad) {
        for (let iter = 0; iter < 24; iter++) {
          for (let i = 0; i < items.length; i++) {
            for (let j = i + 1; j < items.length; j++) {
              const a = items[i];
              const b = items[j];
              const dx = b.x - a.x;
              const dy = b.y - a.y;
              const dist = Math.hypot(dx, dy) || 0.01;
              const minDist = a.r + b.r;
              if (dist >= minDist) continue;
              const overlap = minDist - dist;
              const nx = dx / dist;
              const ny = dy / dist;
              const aFixed = i === draggedIndex;
              const bFixed = j === draggedIndex;
              if (aFixed && !bFixed) {
                b.x += nx * overlap;
                b.y += ny * overlap;
              } else if (bFixed && !aFixed) {
                a.x -= nx * overlap;
                a.y -= ny * overlap;
              } else if (!aFixed && !bFixed) {
                a.x -= nx * overlap * 0.5;
                a.y -= ny * overlap * 0.5;
                b.x += nx * overlap * 0.5;
                b.y += ny * overlap * 0.5;
              }
            }
          }
          items.forEach((c, idx) => {
            if (idx === draggedIndex) return;
            c.x = Math.min(width - pad - c.r, Math.max(pad + c.r, c.x));
            c.y = Math.min(height - pad - c.r, Math.max(pad + c.r, c.y));
          });
        }
      }

      function applyBubblePositions() {
        bubbleChartState.items.forEach((item) => {
          item.el.setAttribute("cx", String(item.x));
          item.el.setAttribute("cy", String(item.y));
          item.labelEls.forEach(({ el, dy }) => {
            el.setAttribute("x", String(item.x));
            el.setAttribute("y", String(item.y + dy));
          });
        });
      }

      // Continuous idle drift: each circle gently bobs around its own resting
      // spot on a slightly different sine/cosine timing so the cluster doesn't
      // move as one block, while the same collision pass used for dragging
      // keeps them from drifting into overlap. A sustained push (eg another
      // circle dragged on top) is folded back into the resting spot each
      // frame so it sticks instead of snapping back on the next oscillation.
      // Skipped entirely for prefers-reduced-motion — those circles just sit
      // at rest.
      let bubbleAnimFrame = null;
      const bubblesReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function bubbleAnimationTick(timestamp) {
        if (!bubbleChartState) {
          bubbleAnimFrame = null;
          return;
        }
        const t = timestamp / 1000;
        const { items, width, height, pad } = bubbleChartState;
        items.forEach((item, i) => {
          if (dragCtx && dragCtx.index === i) return;
          item.x = item.restX + Math.sin(t * item.freq1 + item.phase1) * item.amp;
          item.y = item.restY + Math.cos(t * item.freq2 + item.phase2) * item.amp * 0.7;
        });
        resolveBubbleCollisions(items, dragCtx ? dragCtx.index : -1, width, height, pad);
        items.forEach((item, i) => {
          if (dragCtx && dragCtx.index === i) return;
          const driftX = Math.sin(t * item.freq1 + item.phase1) * item.amp;
          const driftY = Math.cos(t * item.freq2 + item.phase2) * item.amp * 0.7;
          item.restX = item.x - driftX;
          item.restY = item.y - driftY;
        });
        applyBubblePositions();
        bubbleAnimFrame = requestAnimationFrame(bubbleAnimationTick);
      }

      function startBubbleAnimation() {
        if (bubblesReduceMotion || bubbleAnimFrame) return;
        bubbleAnimFrame = requestAnimationFrame(bubbleAnimationTick);
      }

      function onBubblePointerDown(event) {
        if (!bubbleChartState) return;
        const g = event.target.closest(".bubble");
        if (!g) return;
        const svg = bubbleChart.querySelector("svg");
        const point = chartPointFromEvent(svg, event);
        const index = Number(g.dataset.index);
        const item = bubbleChartState.items[index];
        dragCtx = { index, offsetX: point.x - item.x, offsetY: point.y - item.y, g };
        g.classList.add("bubble-dragging");
        g.setPointerCapture(event.pointerId);
        event.preventDefault();
      }

      function onBubblePointerMove(event) {
        if (!dragCtx || !bubbleChartState) return;
        const svg = bubbleChart.querySelector("svg");
        const point = chartPointFromEvent(svg, event);
        const { items, width, height, pad } = bubbleChartState;
        const item = items[dragCtx.index];
        item.x = Math.min(width - pad - item.r, Math.max(pad + item.r, point.x - dragCtx.offsetX));
        item.y = Math.min(height - pad - item.r, Math.max(pad + item.r, point.y - dragCtx.offsetY));
        item.restX = item.x;
        item.restY = item.y;
        resolveBubbleCollisions(items, dragCtx.index, width, height, pad);
        applyBubblePositions();
      }

      function onBubblePointerUp(event) {
        if (!dragCtx) return;
        dragCtx.g.classList.remove("bubble-dragging");
        try {
          dragCtx.g.releasePointerCapture(event.pointerId);
        } catch {
          // capture already released, nothing to do
        }
        dragCtx = null;
      }

      bubbleChart.addEventListener("pointerdown", onBubblePointerDown);
      bubbleChart.addEventListener("pointermove", onBubblePointerMove);
      bubbleChart.addEventListener("pointerup", onBubblePointerUp);
      bubbleChart.addEventListener("pointercancel", onBubblePointerUp);

      function setAllocation(index, rawValue) {
        const left = remaining();
        const cap = allocations[index] + left;
        allocations[index] = Math.max(0, Math.min(cap, rawValue));
        resetCardColors();
        render();
      }

      sliders.forEach((slider, i) => {
        slider.addEventListener("input", () => setAllocation(i, Number(slider.value)));
      });

      document.querySelectorAll(".step-btn").forEach((button) => {
        button.addEventListener("click", () => {
          const index = Number(button.dataset.index);
          const direction = button.dataset.action === "increment" ? 1 : -1;
          setAllocation(index, allocations[index] + direction * STEP);
        });
      });

      const resetButton = document.getElementById("reset-button");
      resetButton.addEventListener("click", () => {
        allocations = allocations.map(() => 0);
        resetCardColors();
        render();
      });

      randomiseButton.addEventListener("click", () => {
        // Randomise in whole $100k units, the same step the +/- buttons use,
        // so every random split lands on the same increments a visitor could
        // reach by hand.
        const totalUnits = FUND_TOTAL / STEP;
        const weights = allocations.map(() => Math.random());
        const weightTotal = weights.reduce((a, b) => a + b, 0);
        const scaledUnits = weights.map((w) => (w / weightTotal) * totalUnits);
        const roundedUnits = largestRemainderRound(scaledUnits, totalUnits);
        allocations = roundedUnits.map((units) => units * STEP);
        resetCardColors();
        render();
      });

      function positionFeeInfo() {
        const margin = 12;
        const toggleRect = feeToggle.getBoundingClientRect();
        const infoRect = feeInfo.getBoundingClientRect();
        let left = toggleRect.left;
        left = Math.min(left, window.innerWidth - infoRect.width - margin);
        left = Math.max(left, margin);
        let top = toggleRect.bottom + 8;
        if (top + infoRect.height > window.innerHeight - margin) {
          top = Math.max(margin, toggleRect.top - infoRect.height - 8);
        }
        feeInfo.style.left = `${left}px`;
        feeInfo.style.top = `${top}px`;
      }

      function openFeeInfo() {
        feeToggle.setAttribute("aria-expanded", "true");
        positionFeeInfo();
        feeInfo.classList.add("fee-info-open");
      }

      function closeFeeInfo() {
        feeToggle.setAttribute("aria-expanded", "false");
        feeInfo.classList.remove("fee-info-open");
      }

      const supportsHoverPopover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

      if (supportsHoverPopover) {
        let hoverCloseTimer = null;
        const cancelHoverClose = () => {
          if (hoverCloseTimer) {
            clearTimeout(hoverCloseTimer);
            hoverCloseTimer = null;
          }
        };
        const scheduleHoverClose = () => {
          cancelHoverClose();
          hoverCloseTimer = setTimeout(closeFeeInfo, 100);
        };
        const showOnHover = () => {
          cancelHoverClose();
          openFeeInfo();
        };

        feeToggle.addEventListener("mouseenter", showOnHover);
        feeToggle.addEventListener("mouseleave", scheduleHoverClose);
        feeToggle.addEventListener("focus", showOnHover);
        feeToggle.addEventListener("blur", scheduleHoverClose);
        feeInfo.addEventListener("mouseenter", cancelHoverClose);
        feeInfo.addEventListener("mouseleave", scheduleHoverClose);
      } else {
        const onOutsideFeeInfoClick = (event) => {
          if (feeInfo.contains(event.target) || feeToggle.contains(event.target)) return;
          closeFeeInfo();
          document.removeEventListener("click", onOutsideFeeInfoClick);
        };

        feeToggle.addEventListener("click", () => {
          const expanded = feeToggle.getAttribute("aria-expanded") === "true";
          if (expanded) {
            closeFeeInfo();
            document.removeEventListener("click", onOutsideFeeInfoClick);
            return;
          }
          openFeeInfo();
          document.addEventListener("click", onOutsideFeeInfoClick);
        });
      }

      // Appears once near the bottom of the page rather than on load, and
      // stays dismissed for the rest of the tab's session once closed.
      const authorPanel = document.getElementById("author-panel");
      const authorPanelClose = document.getElementById("author-panel-close");
      const AUTHOR_PANEL_DISMISSED_KEY = "author-panel-dismissed";

      function isAuthorPanelDismissed() {
        try {
          return sessionStorage.getItem(AUTHOR_PANEL_DISMISSED_KEY) === "1";
        } catch {
          return false;
        }
      }

      function checkAuthorPanelScroll() {
        if (isAuthorPanelDismissed()) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = scrollable > 0 ? window.scrollY / scrollable : 0;
        const nearBottom = scrolled >= 0.8;
        authorPanel.classList.toggle("author-panel-visible", nearBottom);
        authorPanel.setAttribute("aria-hidden", nearBottom ? "false" : "true");
      }

      window.addEventListener("scroll", checkAuthorPanelScroll, { passive: true });
      checkAuthorPanelScroll();

      authorPanelClose.addEventListener("click", () => {
        authorPanel.classList.remove("author-panel-visible");
        authorPanel.setAttribute("aria-hidden", "true");
        try {
          sessionStorage.setItem(AUTHOR_PANEL_DISMISSED_KEY, "1");
        } catch {
          // sessionStorage unavailable (e.g. privacy mode) — dismissal just
          // won't persist across a reload, still works for this page view.
        }
      });

      // Modelled Pareto approximation, calibrated against the aggregate shape
      // reported in Correlation Ventures' venture outcomes data, not sourced
      // from a real per-deal dataset. Parameters are provisional.
      function drawMultiple() {
        const u = Math.random();
        if (u < 0.65) return Math.random(); // total loss to breakeven
        if (u < 0.9) return 1 + Math.random() * 4; // modest return
        if (u < 0.97) return 5 + Math.random() * 5; // strong return
        const xm = 10;
        const alpha = 1.2;
        const v = Math.random();
        return Math.min(xm / Math.pow(1 - v, 1 / alpha), 300); // power-law outlier tail
      }

      function fundMultiple(amounts, multiples) {
        const total = amounts.reduce((sum, amount, i) => sum + amount * multiples[i], 0);
        return total / FUND_TOTAL;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (remaining() !== 0) return;

        remainingBar.hidden = true;

        // The same draw is applied to the visitor's split and to two
        // reference strategies, so the comparison isolates the effect of
        // allocation shape rather than re-rolling the outcome.
        const multiples = allocations.map(() => drawMultiple());
        const evenAmounts = allocations.map(() => FUND_TOTAL / allocations.length);
        // "One concentrated bet" invests the full fund in a randomly picked startup, since a
        // real concentrated bet is placed without knowing in advance which one will be the
        // outlier. Picked fresh each draw so it isn't always the same company.
        const outlierIndex = multiples.indexOf(Math.max(...multiples));
        const concentratedIndex = Math.floor(Math.random() * allocations.length);
        const concentratedAmounts = allocations.map((_, i) => (i === concentratedIndex ? FUND_TOTAL : 0));

        const yourMultiple = fundMultiple(allocations, multiples);
        const evenMultiple = fundMultiple(evenAmounts, multiples);
        const concentratedMultiple = fundMultiple(concentratedAmounts, multiples);

        returnEl.textContent = `${yourMultiple.toFixed(2)}x`;
        compareEl.textContent =
          `Even split: ${evenMultiple.toFixed(2)}x · modelled outcome, not a real fund result.`;

        returnEl.classList.remove("payoff-pop");
        // Force a reflow so the animation class can be re-added on repeat submits.
        void returnEl.offsetWidth;
        returnEl.classList.add("payoff-pop");

        // Per-startup draws: shows which single company actually drove the
        // fund-level number above, rather than leaving the mechanism hidden.
        // Cards converge to the same neutral colour once allocated, since the
        // point is that the split itself doesn't set the outcome apart, only
        // the outlier does — so only that one card stays distinct.
        cards.forEach((card, i) => {
          cardReturns[i].textContent = `Returned ${multiples[i].toFixed(2)}x`;
          const isOutlier = i === outlierIndex;
          const header = card.querySelector(".card-header");
          // Force a reflow so the pulse animation replays even when the same
          // card wins two draws in a row.
          header.classList.remove("card-header-pulse");
          void header.offsetWidth;
          card.classList.toggle("startup-card-outlier", isOutlier);
          header.classList.toggle("card-header-dimmed", !isOutlier);
          header.classList.toggle("card-header-pulse", isOutlier);
          card.style.setProperty("--card-accent", isOutlier ? "var(--outlier-accent)" : "var(--border)");
        });

        breakdownSection.hidden = false;
        renderBubbleChart(multiples);

        // Swaps the illustrative "one outlier carries the fund" chart for the
        // visitor's own result, since a live number makes the point better
        // than a static example once one is available.
        const dollarReturns = allocations.map((amount, i) => amount * multiples[i]);
        const totalDollarReturn = dollarReturns.reduce((a, b) => a + b, 0);
        const shares =
          totalDollarReturn > 0
            ? dollarReturns.map((value) => (value / totalDollarReturn) * 100).sort((a, b) => b - a)
            : dollarReturns.map(() => 0);

        contributionChart.innerHTML = "";
        shares.forEach((share) => {
          const item = document.createElement("div");
          item.className = "bar-chart-item";
          item.innerHTML = `<div class="bar-chart-track"><div class="bar-chart-fill" style="height:${share}%;"></div></div>`;
          contributionChart.appendChild(item);
        });
        contributionCaption.textContent = "Share of your fund's actual return, by startup rank";

        // Swaps the illustrative "diversifying does not change this" chart
        // for the same draw applied to your actual split, since it is
        // already computed above for the headline comparison line.
        const strategyResults = [concentratedMultiple, evenMultiple, yourMultiple];
        const scale = Math.max(1.5, ...strategyResults);
        strategyFills.forEach((fill, i) => {
          fill.style.height = `${(strategyResults[i] / scale) * 100}%`;
        });
        strategyValues.forEach((el, i) => {
          el.textContent = `${strategyResults[i].toFixed(2)}x`;
        });
        strategyLabel2.textContent = "Your split";
        strategyCaption.textContent = "This draw applied to three allocations, including yours";
      });

      render();

      // Tail-heaviness slider for the explainer diagram: reshapes the four
      // illustrative bucket percentages so they always sum to 100, from the
      // static low-tail values up to a much fatter tail at the high end.
      const tailSlider = document.getElementById("tail-slider");
      const tailSliderValue = document.getElementById("tail-slider-value");
      const tailFills = Array.from(document.querySelectorAll("[data-bucket]"));
      const tailValues = Array.from(document.querySelectorAll("[data-bucket-value]"));

      function tailBuckets(t) {
        // As the tail gets heavier, mass moves out of every non-tail bucket and into the
        // extreme-tail bucket. The tail bucket is derived from the other three (rather than
        // given its own fixed formula) so the four always sum to exactly 100.
        const lossBreakeven = 65 - 30 * t;
        const modest = 25 - 5 * t;
        const strong = 7 - 2 * t;
        const tail = 100 - lossBreakeven - modest - strong;
        return [lossBreakeven, modest, strong, tail];
      }

      function updateTailSlider() {
        const t = Number(tailSlider.value) / 100;
        const buckets = tailBuckets(t);
        tailFills.forEach((fill, i) => {
          fill.style.height = `${buckets[i]}%`;
        });
        tailValues.forEach((el, i) => {
          el.textContent = `${Math.round(buckets[i])}%`;
        });
        tailSliderValue.textContent = t < 0.34 ? "mild" : t < 0.67 ? "heavy" : "extreme";
        tailSlider.style.background = `linear-gradient(to right, var(--accent) ${t * 100}%, var(--track) ${t * 100}%)`;
      }

      tailSlider.addEventListener("input", updateTailSlider);
      updateTailSlider();
    </script>
  </body>
</html>
